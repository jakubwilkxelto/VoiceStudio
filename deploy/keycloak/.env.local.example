# Local trial of the multi-user server (docker-compose.local.yml).
# Copy to deploy/keycloak/.env.local and fill in; never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

# Fixed by the local overlay; the base file still requires them.
VOICESTUDIO_DOMAIN=studio.localhost
KEYCLOAK_DOMAIN=auth.localhost

VOICESTUDIO_SESSION_SECRET=
VOICESTUDIO_OIDC_CLIENT_SECRET=
VOICESTUDIO_CLI_CLIENT_SECRET=

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
VOICESTUDIO_INITIAL_PASSWORD=

HF_TOKEN=
