# Copy to deploy/keycloak/.env and fill in. Never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

# DNS names pointing at this host (Caddy gets TLS certificates for both).
VOICESTUDIO_DOMAIN=studio.example.com
KEYCLOAK_DOMAIN=auth.example.com

# Signs and encrypts VoiceStudio session cookies and stored refresh tokens.
VOICESTUDIO_SESSION_SECRET=
# Secret of the confidential Keycloak client "voicestudio" (used by both sides).
VOICESTUDIO_OIDC_CLIENT_SECRET=
# Secret of the "voicestudio-cli" service account for API clients.
VOICESTUDIO_CLI_CLIENT_SECRET=

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# First password of the imported users (studio-admin, alice, bob); each must change it
# on first sign-in.
VOICESTUDIO_INITIAL_PASSWORD=

# Optional: Hugging Face token for gated models.
HF_TOKEN=
